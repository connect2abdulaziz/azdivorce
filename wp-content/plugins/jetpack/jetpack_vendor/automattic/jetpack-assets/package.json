{
  "private": true,
  "scripts": {
    "build": "node init && pnpm run clean && pnpm run build-js",
    "build-js": "node init && webpack",
    "build-production": "node init && pnpm run clean && pnpm run build-production-js && pnpm run validate",
    "build-production-js": "node init && NODE_ENV=production BABEL_ENV=production pnpm run build-js",
    "clean": "rm -rf build",
    "test": "jest --config=tests/jest.config.cjs",
    "test-coverage": "pnpm run test --coverage",
    "validate": "pnpm exec validate-es build/"
  },
  "browserslist": "extends @wordpress/browserslist-config",
  "dependencies": {
    "@automattic/jetpack-script-data": "^0.6.3",
    "@wordpress/i18n": "6.17.0",
    "react": "18.3.1"
  },
  "devDependencies": {
    "@automattic/jetpack-webpack-config": "workspace:*",
    "@wordpress/browserslist-config": "6.44.0",
    "concurrently": "9.2.1",
    "jest": "30.3.0",
    "md5-es": "1.8.2",
    "webpack": "5.105.2",
    "webpack-cli": "6.0.1"
  }
}
